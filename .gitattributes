# Normalise every text file to LF in the repository AND in the working tree, on
# every platform. Without the explicit eol=lf, a Windows checkout applies
# core.autocrlf and lands CRLF on disk, which fails the LF line-ending analyzer
# rule that .editorconfig's end_of_line = lf configures.
* text=auto eol=lf

# Source and project files
*.cs           text diff=csharp
*.slnx         text
*.csproj       text
*.props        text
*.targets      text

# Configuration and documentation
*.json         text
*.xml          text
*.yml          text
*.yaml         text
*.md           text
*.txt          text
*.editorconfig text

# Scripts: LF is required for shell, CRLF for Windows batch
*.sh           text eol=lf
*.ps1          text
*.cmd          text eol=crlf
*.bat          text eol=crlf

# Binaries: never normalise or diff
*.png          binary
*.ico          binary
*.snk          binary
*.pfx          binary
*.nupkg        binary
